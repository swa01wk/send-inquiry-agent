# OpenAI (required only when running the agent; health and tests work without these)
OPENAI_API_KEY=
OPENAI_MODEL=
# Higher = warmer, more varied replies. 0.6 is a good default for this agent.
OPENAI_TEMPERATURE=0.6

OTP_MOCK_CODE=1234
EMAIL_LINK_DEMO=true
MAX_UPLOAD_MB=5
UPLOAD_DIR=./.uploads
SESSION_TTL_MINUTES=120
RATE_LIMIT_SESSION=30/minute
RATE_LIMIT_IP=60/minute
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

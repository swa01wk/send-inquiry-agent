# LLM provider: openai | azure (unset → azure if AZURE_OPENAI_ENDPOINT is set, else openai)
# LLM_PROVIDER=
# Model or deployment name (LLM_MODEL wins over OPENAI_MODEL when both are set)
OPENAI_API_KEY=
OPENAI_MODEL=
# Higher = warmer, more varied replies. 0.6 is a good default for this agent.
# Leave LLM_TEMPERATURE or OPENAI_TEMPERATURE empty to omit temperature (required for GPT-5).
OPENAI_TEMPERATURE=0.6
# LLM_MODEL=
# LLM_TEMPERATURE=
# LLM_REASONING_EFFORT=   # minimal | low | medium | high (reasoning models only)
# Azure OpenAI (when LLM_PROVIDER=azure or AZURE_OPENAI_ENDPOINT is set)
# AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Intent router (L3 §3.5); defaults to the LLM model when unset.
ROUTER_MODEL=
ROUTER_MIN_CONFIDENCE=0.6

OTP_MOCK_CODE=1234
EMAIL_LINK_DEMO=true
MAX_UPLOAD_MB=5
UPLOAD_DIR=./.uploads
SESSION_TTL_MINUTES=120
RATE_LIMIT_SESSION=30/minute
RATE_LIMIT_IP=60/minute
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# openai | scripted (scripted is for the Playwright e2e suite only)
AGENT_MODE=openai

# ---- Simulated Cenomi, dev tools, links (L3 §3.1–3.4) ----
INTEGRATIONS=mock
# /dev/inbox and /api/dev/* (outbox, audit). Dev and demo only.
DEV_TOOLS=true
# Restart-safe JSON snapshots (sessions, simulated systems, audit). Empty = memory only.
DATA_DIR=./.data
# Fault injection, e.g. submit:timeout:1,otp:unavailable
MOCK_FAULTS=
PUBLIC_BASE_URL=http://localhost:5173
RESUME_TOKEN_SECRET=dev-only-change-me
# Human handoff (L3 §3.6): shown on the handoff card; mock cases are emailed to CALL_CENTRE_EMAIL.
# Placeholders until Cenomi confirms the real call-centre details. Keep the quotes: make sources this file.
CALL_CENTRE_PHONE="+966 11 000 0000"
CALL_CENTRE_EMAIL=leasing-callcentre@example.com
CALL_CENTRE_HOURS="Sunday to Thursday, 9 am to 5 pm (Riyadh time)"
# Review lifecycle (L4): the reviewer console and /api/review/* (mock integrations only).
REVIEWER_CONSOLE=true
YARDI_MAX_ATTEMPTS=3
PUBLIC_API_URL=http://localhost:8000
CASE_TTL_DAYS=30
# Intake channels: call-centre console and simulated Tenant Central (mock integrations only).
CALLCENTRE_CONSOLE=false
TENANT_PORTAL=false
# Proactive work (L5): background tick for stalled reviews, escalations and reminders.
PROACTIVE_ENABLED=false
PROACTIVE_TICK_SECONDS=60
EMAIL_LINK_TTL_HOURS=72
RESUME_TTL_DAYS=7

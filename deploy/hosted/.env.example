# deploy/hosted/.env — copy this file to .env on the VM and fill it in. Never commit .env.

# ---- Address and password (Caddy) ----
# The VM's DNS name. On Azure: the VM's "DNS name label", e.g. cenomi-inquiry-poc.uaenorth.cloudapp.azure.com.
# Without one, <public-ip>.sslip.io works too. Ports 80 and 443 must be open for HTTPS.
DOMAIN=
# One shared login for developers and QA. Make the hash with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<the password>'
# Keep the single quotes: the hash contains $ signs.
BASIC_AUTH_USER=cenomi
BASIC_AUTH_HASH=''

# ---- Secrets ----
# A long random string each, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
RESUME_TOKEN_SECRET=

# ---- Model (Azure OpenAI, as for the live evals) ----
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# The Azure deployment name. Empty LLM_TEMPERATURE leaves temperature out (GPT-5 models need that).
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=

# ---- Behaviour (same defaults as `make demo`) ----
OTP_MOCK_CODE=1234
LOG_LEVEL=INFO
RATE_LIMIT_SESSION=30/minute
RATE_LIMIT_IP=60/minute
